---
// Floating pill navbar, after the Reef pattern: a glass-light capsule that
// hovers over the page, holds the wave mark, four exits, the theme toggle and
// one primary action. On phones the links fold into a zero-JS <details> panel.
// The scroll engine lives in ./_navbar.ts: it retracts the bar past 96px,
// redeploys below 32px, measures the compact width, and swaps to dark glass
// while a deep scene passes under it.
import { Icon } from './svg/icons';
import { Button } from './ui/button';
import ThemeToggle from './ui/theme-toggle/ThemeToggle.astro';

const links = [
	{ label: 'Work', href: '/work/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Notes', href: '/blog/' },
	{ label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isActive = (href: string): boolean => path === href || (href !== '/' && path.startsWith(href));

const navLink = [
	'inline-flex min-h-11 items-center rounded-pill px-3.5',
	'font-sans text-[0.9rem] font-medium whitespace-nowrap text-current',
	'transition-colors duration-200 hover:bg-current/8',
].join(' ');
---

<header class="fixed inset-x-0 z-50" data-header>
	<div class="container-page" data-header-track>
		<nav
			class="glass-light text-foreground rounded-pill flex items-center gap-2 py-2.5 pr-2.5 pl-5"
			aria-label="Main navigation"
			data-navbar
		>
			<a
				href="/"
				class="flex min-h-11 shrink-0 items-center gap-2 text-current"
				aria-label="Iqbal Abdurachman home"
				data-header-brand
			>
				<Icon name="wave" size={20} class="text-primary" />
				<span class="font-display text-lg font-semibold tracking-tight">Iqbal Abdurachman</span>
			</a>

			<ul class="mx-auto hidden items-center gap-0.5 lg:flex">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class:list={[navLink, isActive(link.href) && 'bg-current/8 font-semibold']}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="ml-auto flex items-center gap-1 lg:ml-0">
				<ThemeToggle class="text-current hover:bg-current/8" label="Toggle dark mode" />
				<Button href="/contact/" variant="primary" size="sm" class="hidden sm:inline-flex">
					Let&rsquo;s talk
					<Icon name="arrow-right" size={16} />
				</Button>
				<details class="group relative lg:hidden">
					<summary
						class="hover:bg-current/8 grid size-11 cursor-pointer list-none place-items-center rounded-pill transition-colors duration-200 [&::-webkit-details-marker]:hidden"
						aria-label="Open menu"
					>
						<Icon name="menu" size={21} class="group-open:hidden" />
						<Icon name="x" size={21} class="hidden group-open:block" />
					</summary>
					<div
						class="bg-card border-border shadow-float absolute top-[calc(100%+0.75rem)] right-0 z-10 w-64 rounded-card border p-2"
					>
						<ul class="flex flex-col">
							{
								links.map((link) => (
									<li>
										<a
											href={link.href}
											class="font-display hover:bg-muted text-foreground flex min-h-12 items-center rounded-[0.625rem] px-3 text-lg font-semibold"
											aria-current={isActive(link.href) ? 'page' : undefined}
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
						<div class="border-border mt-2 border-t pt-2">
							<Button href="/contact/" variant="primary" class="w-full">
								Let&rsquo;s talk
							</Button>
						</div>
					</div>
				</details>
			</div>
		</nav>
	</div>
</header>

<script>
	import './_navbar';
</script>

<style is:global>
	/* Glass tuning: the shared primitive is 72% opaque, too sealed for a
	 * floating bar. The navbar opens it up -- more see-through, but with the
	 * 20px blur still carrying enough body to keep the links readable over
	 * whatever scrolls underneath. */
	.glass-light[data-navbar] {
		background: color-mix(in oklab, #ffffff 55%, transparent);
	}

	/* .glass-light is calibrated for a light backdrop; in dark mode the bar
	 * re-anchors on the tokens so it stays readable without a single dark: */
	.dark [data-navbar].glass-light {
		background: color-mix(in oklab, var(--reef-background) 60%, transparent);
		border-color: var(--reef-border);
	}

	/* --- Floating offsets ----------------------------------------------------
	 * The bar keeps a visible gap against the rounded hero frame at every
	 * breakpoint, and rides lower than the safe area inset when there is one.
	 * These rules own the `top` value: no Tailwind top utility may fight them. */
	[data-header] {
		top: max(1.25rem, env(safe-area-inset-top));
	}

	@media (min-width: 40rem) {
		[data-header] {
			top: max(1.5rem, env(safe-area-inset-top));
		}
	}

	@media (min-width: 48rem) {
		[data-header] {
			top: max(1.75rem, env(safe-area-inset-top));
		}
	}

	/* --- Retract on scroll ---------------------------------------------------
	 * One curve for the three moving parts (top offset, pill padding, track
	 * width) so the movement reads as a single gesture. data-shrunk is set by
	 * _navbar.ts; the compact width is measured there too (--header-compact). */
	[data-header] {
		transition: top 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	[data-header][data-shrunk='true'] {
		top: max(0.375rem, env(safe-area-inset-top));
	}

	[data-header-track] {
		transition: max-width 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	[data-header][data-shrunk='true'] [data-header-track] {
		max-width: min(100%, var(--header-compact, 100%));
	}

	/* While measuring, no transition may run: otherwise the bar freezes at an
	 * intermediate frame of its own animation. */
	[data-header][data-measuring],
	[data-header][data-measuring] * {
		transition: none !important;
	}

	[data-navbar] {
		transition:
			padding 420ms cubic-bezier(0.22, 0.61, 0.36, 1),
			background-color 300ms,
			border-color 300ms,
			box-shadow 300ms,
			color 300ms;
	}

	[data-header][data-shrunk='true'] [data-navbar] {
		padding-block: 0.3125rem;
		padding-left: 0.875rem;
		padding-right: 0.375rem;
	}

	/* The wordmark follows the movement, discreetly. */
	[data-header-brand] span {
		transition: font-size 420ms cubic-bezier(0.22, 0.61, 0.36, 1);
	}

	[data-header][data-shrunk='true'] [data-header-brand] span {
		font-size: 1rem;
	}

	/* Nobody should be served this movement after asking for calm. */
	@media (prefers-reduced-motion: reduce) {
		[data-header],
		[data-header-track],
		[data-navbar],
		[data-header-brand] span {
			transition: none;
		}
	}
</style>