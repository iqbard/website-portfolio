---
const links = [
	{ label: 'Home', href: '/' },
	{ label: 'Services', href: '/about/' },
	{ label: 'Projects', href: '/work/' },
	{ label: 'Contact', href: '/contact/' },
];
---

<header class="site-header">
	<div class="container nav-inner">
		<a href="/" class="logo" aria-label="Iqbal Abdurachman home">
			<span class="logo-mark">i</span>
			<span>Iqbal Abdurachman</span>
		</a>
		<nav aria-label="Main navigation">
			<ul>
				{links.map((link) => (
					<li><a href={link.href} class:list={{ active: Astro.url.pathname === link.href }}>{link.label}</a></li>
				))}
			</ul>
		</nav>
		<details class="mobile-menu">
			<summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
			<ul>
				{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
		</details>
		<a class="nav-cta" href="https://linkedin.com/in/iqbard26">Let's talk <span aria-hidden="true">↗</span></a>
	</div>
</header>

<style>
	.site-header { background: var(--blue-soft); color: var(--ink); padding: 1.1rem 0; }
	.nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.logo { display: inline-flex; align-items: center; gap: 0.65rem; font-family: var(--font-heading); font-size: 1rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
	.logo-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 0.6rem; color: white; background: var(--blue); font-family: Georgia, serif; font-size: 1.45rem; font-style: italic; }
	nav ul { display: flex; gap: clamp(1rem, 3vw, 2.5rem); list-style: none; }
	nav a { color: var(--muted); font-size: 0.9rem; text-decoration: none; }
	nav a:hover, nav a.active { color: var(--blue); }
	.mobile-menu { display: none; }
	.nav-cta { display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 0.45rem; padding: 0.65rem 1rem; color: white; background: var(--blue); font-size: 0.9rem; text-decoration: none; }
	.nav-cta:hover { background: var(--blue-dark); }
	@media (max-width: 45em) {
		nav { display: none; }
		.logo { font-size: 0.9rem; }
		.mobile-menu { position: relative; display: block; margin-left: auto; }
		.mobile-menu summary { display: grid; width: 2.5rem; height: 2.5rem; gap: 0.25rem; place-content: center; cursor: pointer; list-style: none; }
		.mobile-menu summary::-webkit-details-marker { display: none; }
		.mobile-menu summary span { display: block; width: 1.2rem; height: 2px; background: var(--ink); }
		.mobile-menu ul { position: absolute; top: calc(100% + 0.75rem); right: 0; z-index: 2; display: grid; min-width: 10rem; gap: 0.25rem; padding: 0.5rem; border: 1px solid var(--line); border-radius: 0.6rem; background: white; box-shadow: var(--shadow-sm); list-style: none; }
		.mobile-menu a { display: block; padding: 0.6rem 0.7rem; color: var(--ink); text-decoration: none; }
		.mobile-menu a:hover { color: var(--blue); background: var(--blue-soft); }
	}
</style>
