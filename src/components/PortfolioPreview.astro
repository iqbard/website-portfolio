---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, slug } = Astro.props.project;
const publicSlug = Astro.props.project.id.split('/').pop()?.replace(/\.md$/, '') || slug;
---

<a class="card" href={`/work/${publicSlug}`}>
	<div class="visual"><img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" /></div>
	<div class="info"><div class="tags" aria-label="Project tags">{data.tags.map((tag) => <span class="tag">{tag}</span>)}</div><h2>{data.title}</h2><p>{data.description}</p><span class="read-more">View case study ↗</span></div>
</a>

<style>
	.card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: 0.9rem; color: var(--ink); background: white; box-shadow: var(--shadow-sm); text-decoration: none; transition: transform 0.2s ease, box-shadow 0.2s ease; }
	.card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
	.visual { aspect-ratio: 16 / 9; overflow: hidden; background: var(--blue-soft); }
	.visual img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
	.card:hover .visual img { transform: scale(1.04); }
	.info { padding: 1.35rem; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.8rem; }
	.tag { border-radius: 999px; padding: 0.2rem 0.55rem; color: var(--blue); background: var(--blue-soft); font-size: 0.7rem; font-weight: 700; }
	h2 { font-size: 1.35rem; }
	p { display: -webkit-box; margin-top: 0.55rem; overflow: hidden; color: var(--muted); font-size: 0.85rem; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
	.read-more { display: inline-block; margin-top: 1rem; color: var(--blue); font-size: 0.82rem; font-weight: 700; }
</style>
