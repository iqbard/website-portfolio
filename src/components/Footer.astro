---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="container footer-inner">
		<div>
			<a href="/" class="footer-logo">Iqbal Abdurachman</a>
			<p>Performance marketing, thoughtful digital experiences, and websites that move people to act.</p>
		</div>
		<div class="footer-links">
			<a href="/work/">Work</a>
			<a href="/about/">About</a>
			<a href="https://linkedin.com/in/iqbard26">LinkedIn</a>
			<a href="https://github.com/iqbard">GitHub</a>
		</div>
	</div>
	<div class="container footer-bottom"><span>© {currentYear} Iqbal Abdurachman</span><span>Built with Astro</span></div>
</footer>

<style>
	footer { padding: 4rem 0 1.5rem; color: var(--muted); background: var(--surface-soft); }
	.footer-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; padding-bottom: 3rem; }
	.footer-logo { color: var(--ink); font-family: var(--font-heading); font-size: 1.2rem; font-weight: 800; text-decoration: none; }
	footer p { max-width: 34rem; margin-top: 0.75rem; }
	.footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; align-content: start; }
	.footer-links a { text-decoration: none; }
	.footer-links a:hover { color: var(--blue); }
	.footer-bottom { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 1.25rem; font-size: 0.8rem; }
	@media (max-width: 45em) { .footer-inner { grid-template-columns: 1fr; gap: 2rem; } .footer-bottom { flex-direction: column; gap: 0.4rem; } }
</style>
