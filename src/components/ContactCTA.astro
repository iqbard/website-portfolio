---
// Closing call to action, after the Reef NewsletterInvite: a deep-scene panel
// set inside a padded frame. It stays dark in both themes, carries the accent
// wave in its title, and answers with the house's white pill button.
import { Icon } from './svg/icons';
import { Button } from './ui/button';
---

<div class="bg-background p-2 sm:p-3 md:p-4">
	<aside class="deep-scene rounded-panel relative isolate overflow-hidden" data-deep-scene>
		<div class="container-page relative z-10 flex flex-col items-center gap-6 py-16 text-center md:py-24">
			<h2 class="font-display text-display-sm max-w-2xl sm:text-display-md">
				Interested in working <span class="accent-script">together</span>?
			</h2>
			<p class="measure-prose text-base leading-relaxed text-white/80 md:text-lg">
				Tell me what you&rsquo;re building, where it feels stuck, and what a useful outcome looks
				like. I&rsquo;ll answer with a straight, practical plan.
			</p>
			<Button href="/contact/" variant="hero" size="lg" class="mt-2">
				Send me a message
				<Icon name="send" size={17} />
			</Button>
		</div>
	</aside>
</div>