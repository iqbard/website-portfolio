---
// Head layer: Reef fonts (Space Grotesk for display, Instrument Sans for body)
// loaded via Fontsource, plus ThemeInit so the `.dark` class lands on <html>
// before first paint. No external font CDN, no theme flash.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import ThemeInit from './ui/theme-toggle/ThemeInit.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const {
	title = 'Iqbal Abdurachman | Digital builder & performance marketer',
	description = 'Performance marketing and thoughtful digital experiences by Iqbal Abdurachman.',
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="description" property="og:description" content={description} />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta property="og:title" content={title} />
<meta property="og:type" content="website" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<ThemeInit />