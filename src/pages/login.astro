---
// Login: a split screen after the family pattern. The form column stays on the
// paper tone; the art column is a deep-scene panel that holds in both themes.
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/ui/button';
import { Icon } from '../components/svg/icons';

const fieldLabel = 'grid gap-1.5 text-sm font-semibold';
const field =
	'block w-full rounded-2xl border border-border bg-surface px-4 py-3 text-[0.95rem] caret-primary placeholder:text-muted-foreground/70 transition-[border-color] duration-200 hover:border-foreground/25 focus:border-primary focus:outline-none';
---

<BaseLayout title="Log in | Iqbal Abdurachman" description="Member login screen.">
	<main class="grid min-h-svh lg:grid-cols-2">
		<div class="container-page flex flex-col justify-center py-16 lg:px-16">
			<div class="w-full max-w-md self-center">
				<a href="/" class="text-primary-text inline-flex min-h-11 items-center gap-1.5 text-sm font-bold">
					<Icon name="chevron-left" size={15} />
					Back home
				</a>
				<div class="mt-8 flex flex-col gap-4">
					<p class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase">
						<span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
						Member area
					</p>
					<h1 class="font-display text-display-sm md:text-display-md">
						Welcome <span class="accent-script">back</span>.
					</h1>
					<p class="text-muted-foreground leading-relaxed">
						Use this screen as the starting point for a future client portal or product login.
					</p>
				</div>
				<form class="mt-8 grid gap-4">
					<label class={fieldLabel}>
						Email
						<input type="email" placeholder="you@example.com" class={field} />
					</label>
					<label class={fieldLabel}>
						Password
						<input type="password" placeholder="Your password" class={field} />
					</label>
					<Button type="submit" variant="primary" size="lg" class="mt-2 w-full">
						Log in
						<Icon name="arrow-right" size={16} />
					</Button>
				</form>
				<p class="text-muted-foreground mt-6 text-sm">
					Need an account?
					<a href="/signup/" class="text-primary-text font-bold">Create one</a>
				</p>
			</div>
		</div>

		<aside class="deep-scene relative hidden isolate overflow-hidden lg:flex lg:flex-col lg:justify-end">
			<div class="relative z-10 flex flex-col gap-4 p-16">
				<span class="font-display text-primary text-lg font-bold">01</span>
				<h2 class="font-display max-w-md text-3xl font-bold tracking-tight text-white">
					A calmer way to move digital work forward.
				</h2>
				<p class="max-w-sm leading-relaxed text-white/75">
					Replace this panel with a product promise, client quote, or visual when the purpose of
					the account area is decided.
				</p>
			</div>
		</aside>
	</main>
</BaseLayout>