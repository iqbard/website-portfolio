---
// Note article: back link, eyebrow, display title, meta line, lead, then the
// body in the Reef reading column (.prose). Zero custom article CSS needed.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from '../../components/svg/icons';

export async function getStaticPaths() {
	const projects = await getCollection('work');
	return projects.map((project) => ({
		params: { slug: project.id.split('/').pop()?.replace(/\.md$/, '') },
		props: { project },
	}));
}

const { project } = Astro.props;
const tags: string[] = project.data.tags;
const { Content } = await project.render();
---

<BaseLayout title={`${project.data.title} | Iqbal Abdurachman`} description={project.data.description}>
	<article class="container-page py-16 pb-24 md:py-20 md:pb-28">
		<div class="mx-auto max-w-3xl">
			<a href="/blog/" class="text-primary-text inline-flex min-h-11 items-center gap-1.5 text-sm font-bold">
				<Icon name="chevron-left" size={15} />
				Back to notes
			</a>

			<header class="mt-8 flex flex-col gap-4">
				<p class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase">
					<span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
					{tags[0] || 'Case study'}
				</p>
				<h1 class="font-display text-display-sm sm:text-display-md md:text-display-lg">{project.data.title}</h1>
				<p class="text-muted-foreground text-sm">
					{project.data.publishDate.toLocaleDateString('en-US', {
						month: 'long',
						day: 'numeric',
						year: 'numeric',
					})}
				</p>
				<p class="text-muted-foreground measure-wide border-border border-l-2 border-primary pl-4 text-lg leading-relaxed">
					{project.data.description}
				</p>
			</header>

			<div class="prose mt-12">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>