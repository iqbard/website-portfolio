---
// Case study: back link, the display Hero with tag pills and description, the
// cover image in a framed rounded panel, the body in the Reef reading column,
// then the closing call to action.
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import { Icon } from '../../components/svg/icons';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id.split('/').pop()?.replace(/\.md$/, '') },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const tags: string[] = entry.data.tags;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<article class="pb-20 md:pb-28">
		<header class="bg-surface border-border border-b">
			<div class="container-page flex flex-col gap-8 pt-32 pb-12 md:pt-40 md:pb-16">
				<a href="/work/" class="text-primary-text inline-flex w-max min-h-11 items-center gap-1.5 text-sm font-bold">
					<Icon name="chevron-left" size={15} />
					Work
				</a>
				<Hero title={entry.data.title} align="start">
					<div class="flex flex-col gap-5">
						<div class="flex flex-wrap gap-1.5" aria-label="Project tags">
							{
								tags.map((tag) => (
									<span class="text-primary-text bg-primary/10 rounded-pill px-2.5 py-0.5 text-xs font-semibold">
										{tag}
									</span>
								))
							}
						</div>
						<p class="text-muted-foreground measure-wide text-lg leading-relaxed">{entry.data.description}</p>
					</div>
				</Hero>
			</div>
		</header>

		<div class="container-page">
			{
				entry.data.img && (
					<img
						src={entry.data.img}
						alt={entry.data.img_alt || ''}
						class="border-border shadow-float mx-auto mt-12 w-full rounded-panel border"
					/>
				)
			}
			<div class="prose mx-auto mt-12">
				<Content />
			</div>
		</div>
	</article>

	<ContactCTA />
</BaseLayout>