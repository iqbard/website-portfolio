---
// Home, rebuilt in the Reef art direction: a deep-scene first screen inside a
// padded rounded frame, a quiet industries strip, three service cards (one of
// them dark), the selected work grid, the process rail, a questions block and
// the closing deep-scene call to action. Roles only, never raw colors.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import { Icon } from '../components/svg/icons';
import { Button } from '../components/ui/button';

const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

const faqs = [
	[
		'What kind of work do you take on?',
		'I help ambitious businesses turn unclear digital problems into focused websites, campaigns, and content systems.',
	],
	[
		'Do you work with teams outside Indonesia?',
		'Yes. I work remotely with teams across time zones and keep projects moving through clear documentation and regular check-ins.',
	],
	[
		'Can you improve an existing website?',
		'Absolutely. Audits, conversion improvements, landing pages, and performance work are often the fastest way to create momentum.',
	],
];

const services = [
	{
		number: '01',
		title: 'Performance marketing',
		body: 'Campaigns and landing pages shaped around the metrics that matter, from first click to qualified lead.',
		href: '/about/',
		link: 'Learn more',
	},
	{
		number: '02',
		title: 'Websites that work',
		body: 'Fast, focused websites that make a strong first impression and give people an obvious next step.',
		href: '/work/',
		link: 'See selected work',
	},
	{
		number: '03',
		title: 'Content with direction',
		body: 'Words, structure, and systems that make a brand easier to understand and easier to choose.',
		href: 'https://linkedin.com/in/iqbard26',
		link: 'Start a conversation',
		dark: true,
	},
];

const process = [
	{
		number: '01',
		title: 'Understand',
		body: 'We get clear on the audience, the problem, and the result that would make the work worthwhile.',
	},
	{
		number: '02',
		title: 'Make',
		body: 'I turn the strategy into sharp messaging, considered design, and a useful digital experience.',
	},
	{
		number: '03',
		title: 'Improve',
		body: 'We learn from the response, refine what matters, and build momentum beyond launch day.',
	},
];

const industries = ['Automotive', 'Education', 'Wellness', 'Property', 'Technology'];
---

<BaseLayout title="Iqbal Abdurachman | Digital builder & performance marketer" description="Performance marketing and digital experiences by Iqbal Abdurachman.">
	{/* --- First screen: deep scene in a padded frame --- */}
	<div class="bg-background p-2 sm:p-3 md:p-4">
		<section
			class="deep-scene rounded-panel relative isolate overflow-hidden"
			aria-labelledby="hero-title"
			data-deep-scene
		>
			<div class="container-page relative z-10 flex min-h-[80svh] flex-col justify-center pt-32 pb-14 md:pt-40 md:pb-20 lg:pt-44">
				<div class="grid w-full gap-12 sm:gap-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-end lg:gap-x-16">
					<div class="flex min-w-0 flex-col items-start">
						<p class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase">
							<span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
							Performance marketer · Digital builder
						</p>
						<h1 id="hero-title" class="font-display text-display-lg lg:text-display-xl mt-6">
							Make your next <span class="accent-script">digital</span> move count.
						</h1>
					</div>

					<div class="flex min-w-0 flex-col items-start lg:justify-end lg:pb-2">
						<p class="measure-wide leading-relaxed text-white/85 md:text-lg">
							I&rsquo;m Iqbal, a performance marketer who brings strategy, storytelling, and
							useful design together to help good businesses grow.
						</p>
						<div class="mt-8 flex flex-wrap items-center gap-3">
							<Button href="/work/" variant="primary" size="lg">
								Explore my work
								<Icon name="arrow-right" size={18} />
							</Button>
							<Button href="/about/" variant="outline" size="lg">More about me</Button>
						</div>

						<div class="relative mt-10 lg:mt-14">
							<div class="border-white/20 shadow-lift overflow-hidden rounded-panel border-2 rotate-2">
								<img
									src="/assets/potrait.webp"
									alt="Iqbal Abdurachman"
									class="aspect-4/5 w-56 object-cover object-top sm:w-64"
									loading="eager"
									fetchpriority="high"
								/>
							</div>
							<p class="glass text-white absolute -bottom-3 left-4 flex items-center gap-2 rounded-pill px-4 py-2 text-xs font-medium">
								<span class="inline-block size-2 shrink-0 rounded-full bg-[#3fd080]" aria-hidden="true"></span>
								Available for selected projects
							</p>
						</div>
					</div>
				</div>

				<dl class="border-white/25 mt-12 flex w-full flex-wrap gap-x-10 gap-y-4 border-t pt-6 md:mt-16">
					<div class="flex flex-col gap-0.5">
						<dd class="font-display text-3xl leading-none font-bold tabular-nums md:text-4xl">7+</dd>
						<dt class="text-xs tracking-[0.14em] text-white/75 uppercase">Years of practice</dt>
					</div>
					<div class="flex flex-col gap-0.5">
						<dd class="font-display text-3xl leading-none font-bold tabular-nums md:text-4xl">{projects.length}+</dd>
						<dt class="text-xs tracking-[0.14em] text-white/75 uppercase">Projects shipped</dt>
					</div>
					<div class="flex flex-col gap-0.5">
						<dd class="font-display text-3xl leading-none font-bold tabular-nums md:text-4xl">5</dd>
						<dt class="text-xs tracking-[0.14em] text-white/75 uppercase">Industries served</dt>
					</div>
				</dl>
			</div>
		</section>
	</div>

	{/* --- Industries strip --- */}
	<section class="border-border border-b" aria-label="Industries">
		<div class="container-page flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-5">
			<span class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase">Trusted by teams in</span>
			{industries.map((industry) => <strong class="font-display text-sm font-semibold tracking-tight">{industry}</strong>)}
		</div>
	</section>

	{/* --- Services --- */}
	<section class="container-page py-20 md:py-28">
		<div class="flex w-full flex-col gap-4">
			<p class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase">
				<span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
				Services
			</p>
			<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
				<h2 class="font-display text-display-sm max-w-2xl md:text-display-md">
					<span class="accent-script">Clear</span> thinking for complicated digital problems.
				</h2>
				<p class="text-muted-foreground measure-wide text-lg leading-relaxed">
					I connect the dots between what a business needs to say, what people need to feel, and
					what they need to do next.
				</p>
			</div>
		</div>

		<div class="mt-12 grid gap-4 md:grid-cols-3">
			{
				services.map((service) =>
					service.dark ? (
						<article class="deep-scene rounded-card relative isolate flex flex-col overflow-hidden p-8">
							<span class="font-display text-primary text-lg font-bold">{service.number}</span>
							<h3 class="mt-16 text-2xl font-bold tracking-tight md:mt-20">{service.title}</h3>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-white/75">{service.body}</p>
							<a
								href={service.href}
								class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-white"
								rel={service.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								{service.link}
								<Icon name="arrow-up-right" size={15} />
							</a>
						</article>
					) : (
						<article class="bg-card border-border shadow-float hover:shadow-lift flex flex-col rounded-card border p-8 transition-[transform,box-shadow] duration-200 hover:-translate-y-1">
							<span class="text-primary-text font-display text-lg font-bold">{service.number}</span>
							<h3 class="mt-16 text-2xl font-bold tracking-tight md:mt-20">{service.title}</h3>
							<p class="text-muted-foreground mt-3 flex-1 text-sm leading-relaxed">{service.body}</p>
							<a href={service.href} class="text-primary-text mt-6 inline-flex items-center gap-1.5 text-sm font-bold">
								{service.link}
								<Icon name="arrow-up-right" size={15} />
							</a>
						</article>
					),
				)
			}
		</div>
	</section>

	{/* --- Selected work --- */}
	<section class="bg-surface border-border border-y">
		<div class="container-page py-20 md:py-28">
			<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div class="flex flex-col gap-4">
					<p class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase">
						<span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
						Selected work
					</p>
					<h2 class="font-display text-display-sm max-w-xl md:text-display-md">
						A few things I&rsquo;ve helped bring to <span class="accent-script">life</span>.
					</h2>
				</div>
				<a href="/work/" class="text-primary-text inline-flex w-max items-center gap-1.5 font-bold md:justify-self-end">
					View all work
					<Icon name="arrow-up-right" size={15} />
				</a>
			</div>
			<ul class="mt-12 grid list-none gap-6 p-0 md:grid-cols-2">
				{projects.map((project) => (
					<li><PortfolioPreview project={project} /></li>
				))}
			</ul>
		</div>
	</section>

	{/* --- Process --- */}
	<section class="container-page py-20 md:py-28">
		<div class="flex w-full flex-col gap-4">
			<p class="text-muted-foreground flex items-center gap-3 text-xs font-medium tracking-[0.18em] uppercase">
				<span class="bg-primary inline-block h-px w-8 shrink-0" aria-hidden="true"></span>
				Process
			</p>
			<h2 class="font-display text-display-sm max-w-2xl md:text-display-md">
				Thoughtful from first question to final <span class="accent-script">click</span>.
			</h2>
		</div>
		<div class="mt-12 grid gap-x-10 gap-y-10 md:grid-cols-3">
			{
				process.map((step) => (
					<article class="border-border border-t pt-6">
						<span class="text-primary-text font-display text-sm font-bold">{step.number}</span>
						<h3 class="mt-10 text-2xl font-bold tracking-tight">{step.title}</h3>
						<p class="text-muted-foreground mt-3 text-[0.95rem] leading-relaxed">{step.body}</p>
					</article>
				))
			}
		</div>
	</section>

	{/* --- Questions --- */}
	<section class="bg-surface border-border border-y">
		<div class="container-page grid gap-10 py-20 md:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
			<div>
				<h2 class="font-display text-display-sm max-w-sm md:text-display-md">
					Questions, <span class="accent-script">answered</span>.
				</h2>
				<p class="text-muted-foreground mt-4 max-w-xs leading-relaxed">
					A few practical details before we get into the interesting part.
				</p>
			</div>
			<div>
				{
					faqs.map(([question, answer]) => (
						<details class="group border-border border-t last:border-b">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-bold [&::-webkit-details-marker]:hidden">
								{question}
								<Icon name="plus" size={18} class="text-primary-text shrink-0 transition-transform duration-200 group-open:rotate-45" />
							</summary>
							<p class="text-muted-foreground max-w-2xl pb-5 leading-relaxed">{answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<ContactCTA />
</BaseLayout>