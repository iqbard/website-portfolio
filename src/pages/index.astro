---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const projects = (await getCollection('work')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()).slice(0, 4);
const faqs = [
	['What kind of work do you take on?', 'I help ambitious businesses turn unclear digital problems into focused websites, campaigns, and content systems.'],
	['Do you work with teams outside Indonesia?', 'Yes. I work remotely with teams across time zones and keep projects moving through clear documentation and regular check-ins.'],
	['Can you improve an existing website?', 'Absolutely. Audits, conversion improvements, landing pages, and performance work are often the fastest way to create momentum.'],
];
---

<BaseLayout title="Iqbal Abdurachman | Digital builder & performance marketer" description="Performance marketing and digital experiences by Iqbal Abdurachman.">
	<section class="hero-band"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Performance marketer · Digital builder</p><h1>Make your next digital move count.</h1><p class="subtitle">I’m Iqbal, a performance marketer who brings strategy, storytelling, and useful design together to help good businesses grow.</p><div class="hero-actions"><a class="button button-primary" href="/work/">Explore my work <span aria-hidden="true">↗</span></a><a class="button button-ghost" href="/about/">More about me</a></div><div class="proof"><strong>7+</strong><span>years turning ideas into useful digital experiences</span></div></div><div class="hero-visual"><div class="portrait-frame"><img src="/assets/potrait.webp" alt="Iqbal Abdurachman" /></div><div class="floating-note"><span class="status-dot"></span><span>Available for selected projects</span></div></div></div></section>
	<section class="trust-strip"><div class="container trust-inner"><span>Trusted by teams in</span><strong>Automotive</strong><strong>Education</strong><strong>Wellness</strong><strong>Property</strong><strong>Technology</strong></div></section>
	<section class="section container"><div class="section-heading"><div><h2>Clear thinking for complicated digital problems.</h2></div><p>I connect the dots between what a business needs to say, what people need to feel, and what they need to do next.</p></div><div class="feature-grid"><article class="feature-card feature-card-blue"><span class="feature-number">01</span><h3>Performance marketing</h3><p>Campaigns and landing pages shaped around the metrics that matter, from first click to qualified lead.</p><a href="/about/">Learn more ↗</a></article><article class="feature-card"><span class="feature-number">02</span><h3>Websites that work</h3><p>Fast, focused websites that make a strong first impression and give people an obvious next step.</p><a href="/work/">See selected work ↗</a></article><article class="feature-card feature-card-dark"><span class="feature-number">03</span><h3>Content with direction</h3><p>Words, structure, and systems that make a brand easier to understand and easier to choose.</p><a href="https://linkedin.com/in/iqbard26">Start a conversation ↗</a></article></div></section>
	<section class="section work-section"><div class="container"><div class="section-heading work-heading"><div><p class="eyebrow">Selected work</p><h2>A few things I’ve helped bring to life.</h2></div><a class="text-link" href="/work/">View all work ↗</a></div><ul class="work-grid">{projects.map((project) => <li><PortfolioPreview project={project} /></li>)}</ul></div></section>
	<section class="section container process-section"><div class="section-heading"><div><h2>Thoughtful from first question to final click.</h2></div></div><div class="process-grid"><article><span>01</span><h3>Understand</h3><p>We get clear on the audience, the problem, and the result that would make the work worthwhile.</p></article><article><span>02</span><h3>Make</h3><p>I turn the strategy into sharp messaging, considered design, and a useful digital experience.</p></article><article><span>03</span><h3>Improve</h3><p>We learn from the response, refine what matters, and build momentum beyond launch day.</p></article></div></section>
	<section class="section faq-section"><div class="container faq-grid"><div><h2>Questions, answered.</h2><p class="faq-intro">A few practical details before we get into the interesting part.</p></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div></section>
	<section class="cta-section"><div class="container cta-inner"><div><p class="eyebrow">Have a good one?</p><h2>Let’s make it useful.</h2><p>Tell me what you’re working on, where it feels stuck, and what better could look like.</p></div><a class="button button-light" href="https://linkedin.com/in/iqbard26">Let’s talk <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>

<style>
	.hero-band { background: var(--blue-soft); padding: 5rem 0 6rem; }
	.hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 4rem; }
	.eyebrow { color: var(--blue); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	.hero-copy h1 { max-width: 10ch; margin-top: 1rem; }
	.subtitle { max-width: 35rem; margin-top: 1.5rem; color: var(--muted); font-size: 1.15rem; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
	.button { display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; border-radius: 0.45rem; padding: 0.85rem 1.1rem; font-weight: 600; text-decoration: none; transition: transform 0.2s ease, background 0.2s ease; }
	.button:hover { transform: translateY(-2px); }
	.button-primary { color: white; background: var(--blue); }
	.button-primary:hover { background: var(--blue-dark); }
	.button-ghost { color: var(--blue); border: 1px solid var(--blue); }
	.proof { display: flex; align-items: center; gap: 0.75rem; margin-top: 3rem; color: var(--muted); font-size: 0.85rem; }
	.proof strong { color: var(--blue); font-family: var(--font-heading); font-size: 2.3rem; }
	.proof span { max-width: 16rem; }
	.hero-visual { position: relative; max-width: 28rem; justify-self: end; }
	.portrait-frame { overflow: hidden; border-radius: 1.2rem; background: var(--blue); box-shadow: var(--shadow-md); transform: rotate(2deg); }
	.portrait-frame img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; filter: saturate(0.85); }
	.floating-note { position: absolute; right: -2rem; bottom: 2rem; display: flex; align-items: center; gap: 0.6rem; max-width: 13rem; border-radius: 0.65rem; padding: 0.8rem 1rem; color: var(--ink); background: white; box-shadow: var(--shadow-sm); font-size: 0.78rem; }
	.status-dot { width: 0.55rem; height: 0.55rem; flex: 0 0 auto; border-radius: 50%; background: #28c76f; }
	.trust-strip { border-bottom: 1px solid var(--line); background: white; }
	.trust-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.4rem 0; color: var(--muted); font-size: 0.82rem; }
	.trust-inner strong { color: var(--ink); font-family: var(--font-heading); font-size: 0.9rem; }
	.section { padding-top: 7rem; padding-bottom: 7rem; }
	.section-heading { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: end; gap: 3rem; margin-bottom: 2.5rem; }
	.section-heading h2 { max-width: 16ch; margin-top: 0.7rem; }
	.section-heading > p { max-width: 29rem; color: var(--muted); }
	.feature-grid { display: grid; grid-template-columns: 1.35fr 0.85fr; grid-template-rows: 1fr 1fr; gap: 1rem; }
	.feature-card:first-child { grid-row: span 2; }
	.feature-card { min-height: 19rem; border-radius: 0.9rem; padding: 2rem; background: var(--surface-soft); }
	.feature-card-blue { background: var(--blue-soft); }
	.feature-card-dark { color: white; background: var(--blue-dark); }
	.feature-card-dark h3, .feature-card-dark .feature-number { color: white; }
	.feature-number { display: block; margin-bottom: 4rem; color: var(--blue); font-family: var(--font-heading); font-weight: 800; }
	.feature-card h3 { font-size: 1.45rem; }
	.feature-card p { margin-top: 0.75rem; color: var(--muted); font-size: 0.9rem; }
	.feature-card-dark p { color: #b9c8e9; }
	.feature-card a { display: inline-block; margin-top: 1.25rem; color: var(--blue); font-size: 0.85rem; font-weight: 700; text-decoration: none; }
	.feature-card-dark a { color: white; }
	.work-section, .faq-section { background: var(--surface-soft); }
	.work-heading { align-items: center; }
	.text-link { display: inline-flex; width: max-content; justify-self: end; align-items: center; color: var(--blue); font-weight: 700; text-decoration: none; }
	.work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; list-style: none; padding: 0; }
	.process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; border-top: 1px solid var(--line); padding-top: 2rem; }
	.process-grid article { padding-right: 1.5rem; border-right: 1px solid var(--line); }
	.process-grid article:last-child { border-right: 0; }
	.process-grid span { color: var(--blue); font-family: var(--font-heading); font-weight: 800; }
	.process-grid h3 { margin-top: 2.5rem; font-size: 1.4rem; }
	.process-grid p { margin-top: 0.75rem; color: var(--muted); font-size: 0.9rem; }
	.faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 5rem; }
	.faq-intro { max-width: 20rem; margin-top: 1rem; color: var(--muted); }
	.faq-list details { border-top: 1px solid var(--line); padding: 1.25rem 0; }
	.faq-list details:last-child { border-bottom: 1px solid var(--line); }
	.faq-list summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; font-weight: 700; list-style: none; }
	.faq-list summary::-webkit-details-marker { display: none; }
	.faq-list summary span { color: var(--blue); font-size: 1.3rem; }
	.faq-list details p { max-width: 42rem; margin-top: 0.8rem; color: var(--muted); }
	.cta-section { color: white; background: var(--blue); padding: 5rem 0; }
	.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
	.cta-section .eyebrow, .cta-section h2 { color: white; }
	.cta-section h2 { margin-top: 0.7rem; }
	.cta-section p:last-child { max-width: 30rem; margin-top: 0.8rem; color: #dbe5ff; }
	.button-light { color: var(--blue); background: white; }
	@media (max-width: 55em) { .hero-grid, .section-heading, .faq-grid, .feature-grid { grid-template-columns: 1fr; } .hero-visual { justify-self: start; width: min(100%, 28rem); } .feature-grid { grid-template-rows: auto; } .feature-card:first-child { grid-row: auto; } .process-grid { grid-template-columns: 1fr; } .process-grid article { border-right: 0; border-bottom: 1px solid var(--line); padding: 0 0 1.5rem; } .process-grid article:last-child { border-bottom: 0; } .process-grid h3 { margin-top: 1rem; } .faq-grid { gap: 2rem; } }
	@media (max-width: 40em) { .hero-band { padding: 3.5rem 0 4rem; } .section { padding-top: 4.5rem; padding-bottom: 4.5rem; } .work-grid { grid-template-columns: 1fr; } .floating-note { right: 0; } .cta-inner { align-items: flex-start; flex-direction: column; } }
</style>
