---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Iqbal Abdurachman" description="Start a conversation about your next digital project.">
	<section class="contact-hero"><div class="container contact-grid"><div><p class="eyebrow">Contact</p><h1>Let’s talk about what comes next.</h1><p class="subtitle">Use this page as your contact template. Replace the details below with the channels and form destination you want to use.</p><div class="contact-cards"><a href="mailto:hello@example.com"><span>✉</span><div><small>Send an email</small><strong>hello@example.com</strong></div></a><a href="https://linkedin.com/in/iqbard26"><span>↗</span><div><small>Connect on LinkedIn</small><strong>linkedin.com/in/iqbard26</strong></div></a><div><span>⌖</span><div><small>Based in</small><strong>Jakarta, Indonesia</strong></div></div></div></div><div class="form-card"><h2>Tell me a little more.</h2><p>Give the template some context and I’ll get back to you.</p><form><label for="name">Name<input id="name" name="name" placeholder="Your name" /></label><label for="email">Email<input id="email" name="email" type="email" placeholder="you@example.com" /></label><label for="message">What are you working on?<textarea id="message" name="message" rows="5" placeholder="A few words about the project"></textarea></label><button class="button button-primary" type="submit">Send inquiry <span aria-hidden="true">↗</span></button></form></div></div></section>
</BaseLayout>

<style>
	.contact-hero { padding: 5rem 0 7rem; background: var(--blue-soft); }
	.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
	.contact-hero h1 { max-width: 11ch; margin-top: 0.75rem; }
	.subtitle { max-width: 35rem; margin-top: 1.25rem; color: var(--muted); font-size: 1.1rem; }
	.contact-cards { display: grid; gap: 0.75rem; margin-top: 2.5rem; }
	.contact-cards a, .contact-cards > div { display: grid; grid-template-columns: 2.75rem 1fr; gap: 0.85rem; align-items: center; border-radius: 0.65rem; padding: 1rem; color: var(--ink); background: white; text-decoration: none; }
	.contact-cards a:hover strong { color: var(--blue); }
	.contact-cards span { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--blue); }
	.contact-cards small, .contact-cards strong { display: block; }
	.contact-cards small { color: var(--muted); font-size: 0.75rem; }
	.contact-cards strong { margin-top: 0.15rem; font-size: 1rem; }
	.form-card { border-radius: 0.9rem; padding: 2rem; background: white; box-shadow: var(--shadow-md); }
	.form-card h2 { font-size: 1.7rem; }
	.form-card > p { margin-top: 0.5rem; color: var(--muted); }
	form { display: grid; gap: 1rem; margin-top: 1.75rem; }
	label { display: grid; gap: 0.4rem; color: var(--ink); font-size: 0.85rem; font-weight: 600; }
	input, textarea { width: 100%; border: 1px solid var(--line); border-radius: 0.4rem; padding: 0.8rem; color: var(--ink); background: var(--surface-soft); font: inherit; }
	input:focus, textarea:focus { outline: 2px solid var(--blue); outline-offset: 1px; }
	.button { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border: 0; border-radius: 0.45rem; padding: 0.85rem 1rem; font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
	.button-primary { color: white; background: var(--blue); }
	@media (max-width: 55em) { .contact-grid { grid-template-columns: 1fr; gap: 3rem; } }
</style>
