---
import BaseLayout from '../layouts/BaseLayout.astro';

const plans = [
	{ name: 'Starter', price: 'From $500', description: 'A focused starting point for a clear, useful digital presence.', features: ['Strategy session', 'Single landing page', 'Performance recommendations'], featured: false },
	{ name: 'Growth', price: 'From $1,500', description: 'A complete website or campaign system built to create momentum.', features: ['Discovery and strategy', 'Multi-page experience', 'Launch support'], featured: true },
	{ name: 'Partner', price: 'Let’s talk', description: 'Ongoing creative and performance support for teams moving quickly.', features: ['Flexible monthly scope', 'Testing and iteration', 'Priority collaboration'], featured: false },
];
---

<BaseLayout title="Pricing | Iqbal Abdurachman" description="Flexible services for digital projects of different shapes and sizes.">
	<section class="page-hero"><div class="container narrow"><p class="eyebrow">Services & pricing</p><h1>Flexible plans for meaningful digital work.</h1><p class="subtitle">A template for now. Replace these packages, prices, and features when you are ready to define your offer.</p></div></section>
	<section class="section container"><div class="plans">{plans.map((plan) => <article class:list={['plan', { featured: plan.featured }]}><p class="plan-label">{plan.name}</p><h2>{plan.price}</h2><p class="plan-description">{plan.description}</p><ul>{plan.features.map((feature) => <li><span>✓</span>{feature}</li>)}</ul><a class="button" href="/contact/">Choose {plan.name} <span aria-hidden="true">↗</span></a></article>)}</div></section>
	<section class="comparison"><div class="container"><div class="narrow centered"><p class="eyebrow">At a glance</p><h2>Compare what’s included.</h2></div><div class="comparison-table"><div class="comparison-row header"><strong>Included</strong><strong>Starter</strong><strong>Growth</strong><strong>Partner</strong></div>{['Strategy and discovery', 'Website or landing page', 'Content direction', 'Performance review', 'Ongoing support'].map((item, index) => <div class="comparison-row"><span>{item}</span><span>{index < 2 ? '✓' : '—'}</span><span>✓</span><span>{index === 4 ? '✓' : 'Available'}</span></div>)}</div></div></section>
	<section class="cta-section"><div class="container cta-inner"><div><p class="eyebrow">Not sure yet?</p><h2>Start with a conversation.</h2><p>We can shape the right scope together.</p></div><a class="button button-light" href="/contact/">Contact me ↗</a></div></section>
</BaseLayout>

<style>
	.page-hero { padding: 5rem 0 4rem; background: var(--blue-soft); text-align: center; }
	.narrow { max-width: 46rem; margin-inline: auto; }
	.page-hero h1 { margin-top: 0.75rem; }
	.subtitle { margin-top: 1.25rem; color: var(--muted); font-size: 1.1rem; }
	.centered { text-align: center; }
	.centered h2 { margin-top: 0.7rem; }
	.plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.plan { display: flex; flex-direction: column; min-height: 26rem; border: 1px solid var(--line); border-radius: 0.9rem; padding: 2rem; background: white; box-shadow: var(--shadow-sm); }
	.plan.featured { color: white; border-color: var(--blue); background: var(--blue); transform: translateY(-1rem); }
	.plan-label { color: var(--blue); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; }
	.featured .plan-label, .featured h2 { color: white; }
	.plan h2 { margin-top: 1rem; font-size: 2rem; }
	.plan-description { min-height: 4rem; margin-top: 0.75rem; color: var(--muted); font-size: 0.9rem; }
	.featured .plan-description { color: #dbe5ff; }
	.plan ul { display: grid; gap: 0.7rem; margin: 1.5rem 0 2rem; padding: 1.5rem 0; border-top: 1px dashed var(--line); list-style: none; font-size: 0.88rem; }
	.featured ul { border-color: rgb(255 255 255 / 0.35); }
	.plan li { display: flex; gap: 0.5rem; }
	.plan li span { color: var(--blue); font-weight: 700; }
	.featured li span { color: white; }
	.plan .button { margin-top: auto; color: var(--blue); border: 1px solid var(--blue); }
	.featured .button { color: var(--blue); background: white; }
	.comparison { padding: 6rem 0; background: var(--surface-soft); }
	.comparison-table { margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 0.75rem; background: white; }
	.comparison-row { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
	.comparison-row:last-child { border-bottom: 0; }
	.comparison-row span:not(:first-child), .comparison-row strong:not(:first-child) { text-align: center; }
	.comparison-row.header { color: var(--ink); background: var(--blue-soft); font-family: var(--font-heading); }
	@media (max-width: 55em) { .plans { grid-template-columns: 1fr; } .plan.featured { transform: none; } }
	@media (max-width: 40em) { .comparison-row { grid-template-columns: 1.5fr repeat(3, 0.7fr); padding-inline: 0.65rem; font-size: 0.76rem; } }
</style>
