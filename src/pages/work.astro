---
// Work archive: a quiet PageHero band, pill filters that hide server-rendered
// cards, the project grid, and the closing deep-scene call to action.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import PageHero from '../components/PageHero.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const categories: string[] = ['All', ...new Set(projects.map((project) => project.data.category))];

const tab =
	'inline-flex min-h-11 cursor-pointer items-center rounded-pill border px-4 text-sm font-semibold transition-colors duration-200';
const tabIdle = 'border-border bg-card text-muted-foreground hover:border-foreground/25 hover:text-foreground';
const tabActive = 'border-primary bg-primary text-primary-foreground';
---

<BaseLayout title="Work | Iqbal Abdurachman" description="Websites, campaigns, and digital systems built by Iqbal Abdurachman.">
	<main>
		<PageHero
			eyebrow="Work"
			title="Work that turns a good idea into a useful experience."
			accentWord="useful"
			lede="A collection of websites, campaigns, and digital systems built with clarity, care, and momentum."
		/>

		<div class="container-page py-16 md:py-24">
			<div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter projects by category">
				{
					categories.map((category, index) => (
						<button
							class={`${tab} ${index === 0 ? tabActive : tabIdle}`}
							type="button"
							role="tab"
							aria-selected={index === 0 ? 'true' : 'false'}
							data-category={category}
						>
							{category}
						</button>
					))
				}
			</div>
			<p class="text-muted-foreground mt-8" hidden>No projects are available in this category yet.</p>
			<ul class="mt-8 grid list-none gap-6 p-0 md:grid-cols-2">
				{
					projects.map((project) => (
						<li data-project-category={project.data.category}>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</ul>
		</div>
	</main>

	<ContactCTA />
</BaseLayout>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('[data-category]');
	const projects = document.querySelectorAll<HTMLElement>('[data-project-category]');
	const emptyState = document.querySelector<HTMLElement>('.filter-empty');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const category = tab.dataset.category;
			let visibleCount = 0;

			tabs.forEach((item) => {
				const selected = item === tab;
				item.setAttribute('aria-selected', selected ? 'true' : 'false');
				item.classList.toggle('border-primary', selected);
				item.classList.toggle('bg-primary', selected);
				item.classList.toggle('text-primary-foreground', selected);
				item.classList.toggle('border-border', !selected);
				item.classList.toggle('bg-card', !selected);
				item.classList.toggle('text-muted-foreground', !selected);
			});

			projects.forEach((project) => {
				const isVisible = category === 'All' || project.dataset.projectCategory === category;
				project.hidden = !isVisible;
				if (isVisible) visibleCount += 1;
			});

			if (emptyState) emptyState.hidden = visibleCount > 0;
		});
	});
</script>