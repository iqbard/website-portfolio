---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const categories = ['All', ...new Set(projects.map((project) => project.data.category))];
---

<BaseLayout
	title="My Work | Iqbal Abdurachman"
	description="Learn about Iqbal Abdurachman most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<header class="page-hero">
				<div class="container narrow">
					<p class="eyebrow">Projects</p>
					<h1>Work that turns a good idea into a useful experience.</h1>
					<p class="subtitle">A collection of websites, campaigns, and digital systems built with clarity, care, and momentum.</p>
				</div>
			</header>
			<div class="project-controls" role="tablist" aria-label="Filter projects by category">
				{categories.map((category, index) => (
					<button class="category-tab" type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-category={category}>
						{category}
					</button>
				))}
			</div>
			<p class="filter-empty" hidden>No projects are available in this category yet.</p>
			<ul class="project-grid">
				{
					projects.map((project) => (
						<li data-project-category={project.data.category}>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</ul>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.page-hero {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: 5rem 1rem 4rem;
		background: var(--blue-soft);
		text-align: center;
	}

	.narrow {
		max-width: 48rem;
		margin-inline: auto;
	}

	.eyebrow {
		color: var(--blue);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.page-hero h1 {
		margin-top: 0.75rem;
	}

	.subtitle {
		margin-top: 1.25rem;
		color: var(--muted);
		font-size: 1.1rem;
	}

	.project-controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.category-tab {
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.65rem 0.9rem;
		color: var(--muted);
		background: white;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
	}

	.category-tab:hover,
	.category-tab[aria-selected='true'] {
		border-color: var(--blue);
		color: white;
		background: var(--blue);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		list-style: none;
		padding: 0;
	}

	.project-grid li[hidden] {
		display: none;
	}

	.filter-empty {
		margin: 1rem 0 2rem;
		color: var(--muted);
	}

	@media (max-width: 45em) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('[data-category]');
	const projects = document.querySelectorAll<HTMLElement>('[data-project-category]');
	const emptyState = document.querySelector<HTMLElement>('.filter-empty');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const category = tab.dataset.category;
			let visibleCount = 0;

			tabs.forEach((item) => item.setAttribute('aria-selected', item === tab ? 'true' : 'false'));
			projects.forEach((project) => {
				const isVisible = category === 'All' || project.dataset.projectCategory === category;
				project.hidden = !isVisible;
				if (isVisible) visibleCount += 1;
			});

			if (emptyState) emptyState.hidden = visibleCount > 0;
		});
	});
</script>
