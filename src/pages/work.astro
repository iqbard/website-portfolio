---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="My Work | Iqbal Abdurachman"
	description="Learn about Iqbal Abdurachman most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<header class="page-hero">
				<div class="container narrow">
					<p class="eyebrow">Projects</p>
					<h1>Work that turns a good idea into a useful experience.</h1>
					<p class="subtitle">A collection of websites, campaigns, and digital systems built with clarity, care, and momentum.</p>
				</div>
			</header>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.page-hero {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: 5rem 1rem 4rem;
		background: var(--blue-soft);
		text-align: center;
	}

	.narrow {
		max-width: 48rem;
		margin-inline: auto;
	}

	.eyebrow {
		color: var(--blue);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.page-hero h1 {
		margin-top: 0.75rem;
	}

	.subtitle {
		margin-top: 1.25rem;
		color: var(--muted);
		font-size: 1.1rem;
	}
</style>
